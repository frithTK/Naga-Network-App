[Unit]
Description=Naga Network local control-plane (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
Group=%i
SupplementaryGroups=naga-network
WorkingDirectory=@NAGA_HOME@/.local/share/naga-network
ExecStart=@NAGA_HOME@/.local/bin/naga-control --sing-box=/usr/bin/sing-box --production --token-file=@NAGA_HOME@/.local/share/naga-network/control.token
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
DeviceAllow=/dev/net/tun rw
PrivateTmp=true

[Install]
WantedBy=multi-user.target
