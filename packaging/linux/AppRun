#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
source "${HERE}/runtime/runtime-lib.sh"

# A replacement must wait until the previous GtkApplication releases its ID.
if [[ "${1:-}" == "--wait-for-pid" ]]; then
  [[ "${2:-}" =~ ^[1-9][0-9]*$ && "$2" != "$$" ]] || exit 2
  previous_pid="$2"
  shift 2
  for _ in {1..300}; do
    kill -0 "${previous_pid}" 2>/dev/null || break
    sleep 0.1
  done
  if kill -0 "${previous_pid}" 2>/dev/null; then
    echo "Предыдущая версия Naga ещё работает." >&2
    exit 1
  fi
fi
case "${1:-}" in
  --version)
    printf 'Naga Network %s\n' "$(<"${HERE}/runtime/runtime.version")"
    exit 0 ;;
  --control)
    shift
    exec "${HERE}/runtime/naga-control" "$@" ;;
esac
[[ "${EUID}" != "0" ]] || { echo "Запускайте Naga от обычного пользователя." >&2; exit 1; }
user_name="$(id -un)"
data_dir="${HOME}/.local/share/naga-network"
naga_prepare_runtime "${HERE}/runtime" "${HOME}/.local/lib/naga-network" \
  "${HOME}/.local/bin" "${data_dir}" "${user_name}"
if [[ "${1:-}" == "--prepare-runtime" || "${1:-}" == "--install-runtime" ]]; then
  exit 0
fi
export NAGA_DATA_DIR="${data_dir}"
export NAGA_CONTROL_TOKEN_FILE="${data_dir}/control.token"
unset NAGA_CONTROL_TOKEN
export LD_LIBRARY_PATH="${HERE}/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "${HERE}/naga_network" "$@"
